config_version=5

[application]
config/name="Tram Sim France"
config/version="0.13.2"
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
PerformanceProbe="*res://src/diagnostics/performance_telemetry.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
shading/overrides/force_vertex_shading=false
shading/overrides/force_vertex_shading.mobile=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="vulkan"
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
gl_compatibility/fallback_to_angle=true
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/directional_shadow/16_bits.mobile=true

[shader_globals]

night={
"type": "float",
"value": 0.0
}
