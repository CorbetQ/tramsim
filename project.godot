config_version=5

[application]
config/name="Tram Sim France"
config/version="0.13.1"
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
shading/overrides/force_vertex_shading=false
shading/overrides/force_vertex_shading.mobile=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/msaa_3d.mobile=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/directional_shadow/16_bits.mobile=true

[shader_globals]

night={
"type": "float",
"value": 0.0
}
